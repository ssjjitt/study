<!DOCTYPE html>
<html lang="ru">
<head>
    <title>Lab12 - Электронная цифровая подпись</title>
    <meta charset="utf-8"/>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container">
    <ul class="nav nav-tabs justify-content-center">
        <li class="nav-item">
            <a class="nav-link <%= algorithm === 'rsa' ? 'active' : '' %>" href="/rsa">RSA</a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= algorithm === 'el-gamal' ? 'active' : '' %>" href="/el-gamal">Эль-Гамаля</a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= algorithm === 'schnorr' ? 'active' : '' %>" href="/schnorr">Шнорра</a>
        </li>
    </ul>
    
    <h2 class="text-center">
        <% if (algorithm === 'rsa') { %>
            Алгоритм RSA
        <% } else if (algorithm === 'el-gamal') { %>
            Алгоритм Эль-Гамаля
        <% } else { %>
            Алгоритм Шнорра
        <% } %>
    </h2>
    
    <div class="original-message">
        <h5 class="text-center">Оригинальное сообщение:</h5>
        <p class="text-center mb-0"><%= originalText %></p>
    </div>
    
    <h5 class="text-center">Публичный ключ</h5>
    <div class="key-box">
        <% if (algorithm === 'rsa') { %>
            (e, n) = (<%= publicKey.e %>, <%= publicKey.n %>)
        <% } else if (algorithm === 'el-gamal') { %>
            (p, g, y) = (<%= publicKey.p %>, <%= publicKey.g %>, <%= publicKey.y %>)
        <% } else { %>
            (p, g, q, y) = (<%= publicKey.p %>, <%= publicKey.g %>, <%= publicKey.q %>, <%= publicKey.y %>)
        <% } %>
    </div>
    
    <h5 class="text-center">Цифровая подпись <span class="time-badge"><%= signTime %> мс</span></h5>
    <div class="signature-box">
        <% if (algorithm === 'rsa') { %>
            <%= digitalSign %>
        <% } else if (algorithm === 'el-gamal') { %>
            S = {a, b} = <%= digitalSign %>
        <% } else { %>
            S = {h, b} = <%= digitalSign %>
        <% } %>
    </div>
    
    <h5 class="text-center">Верификация подписи <span class="time-badge"><%= verificationTime %> мс</span></h5>
    <div class="verification-box <%= verified === 'да' ? '' : 'verification-fail' %>">
        <p class="text-center mb-0">Подпись достоверна? - <strong><%= verified %></strong></p>
    </div>
</div>
</body>
</html>