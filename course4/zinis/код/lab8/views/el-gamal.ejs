<!DOCTYPE html>
<html lang="ru">
<head>
    <title>Lab10 - Ассиметричные шифры RSA и Эль-Гамаля</title>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
</head>
<body>
<div class="container animate__animated animate__fadeIn">
    <ul class="nav justify-content-center mb-4">
        <li class="nav-item">
            <a class="nav-link active" href="/rsa">RSA</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/el-gamal">Эль-Гамаля</a>
        </li>
    </ul>
    <h2 class="text-center">Алгоритм Эль-Гамаля</h2>
    
    <div class="data-box">
        <h5 class="text-center">Оригинальное сообщение</h5>
        <p class="text-center lead"><%= originalText %></p>
    </div>
    
    <div class="data-box">
        <h5 class="text-center">Зашифрованное сообщение <span class="time-badge"><%= encryptionTime %>мс</span></h5>
        <div class="encrypted-data text-break"><%= encryptedData %></div>
    </div>
    
    <div class="data-box">
        <h5 class="text-center">Расшифрованное сообщение <span class="time-badge"><%= decryptionTime %>мс</span></h5>
        <p class="lead"><%= decryptedData %></p>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>