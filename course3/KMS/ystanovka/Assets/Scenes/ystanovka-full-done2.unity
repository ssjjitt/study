  message: "\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u043A\u0443
    \u043C\u043E\u0441\u0442\u0430 \u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0435\u043C\u043A\u043E\u0441\u0442\u0438
    C0(\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0437\u0430\u043D\u0435\u0441\u0442\u0438
